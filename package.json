{
  "name": "agent-math-terminal",
  "version": "0.2.0-preview.30",
  "private": true,
  "type": "module",
  "description": "LaTeX and math rendering for Codex CLI and Claude Code in Windows Terminal.",
  "repository": {
    "type": "git",
    "url": "https://github.com/creDreams/terminal-math-renderer.git"
  },
  "homepage": "https://github.com/creDreams/terminal-math-renderer#readme",
  "bugs": "https://github.com/creDreams/terminal-math-renderer/issues",
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build:windows": "node scripts/build-windows.mjs",
    "start:windows": "node scripts/start-windows.mjs",
    "pack:windows": "npm run build:windows && node scripts/package-windows.mjs",
    "test:windows": "npm run test:windows-core && npm run test:windows-lazy && node scripts/test-windows-native.mjs && node scripts/test-windows-history.mjs && npm run test:windows-scroll && npm run test:windows-positions && npm run test:windows-bottom && npm run test:windows-environments && npm run test:windows-stream && npm run test:windows-redraw",
    "test:windows-lazy": "node scripts/test-windows-lazy.mjs",
    "test:windows-inline-history": "node scripts/test-windows-lazy.mjs --inline",
    "benchmark:history-lookup": "tsx scripts/benchmark-history-lookup.ts",
    "test:windows-inline": "node scripts/test-windows-inline.mjs",
    "test:windows-claude": "node scripts/test-windows-claude.mjs",
    "test:windows-background": "node scripts/test-windows-background.mjs",
    "test:windows-inline-geometry": "node scripts/test-windows-inline-geometry.mjs",
    "evaluate:inline": "tsx scripts/evaluate-inline.ts",
    "diagnose:claude": "tsx scripts/diagnose-claude-math.ts",
    "capture:showcase": "node scripts/capture-showcase.mjs",
    "test:windows-scroll": "node scripts/test-windows-scroll.mjs",
    "test:windows-history": "node scripts/test-windows-history.mjs",
    "test:windows-live": "node scripts/test-windows-live.mjs",
    "test:windows-live-stream": "node scripts/test-windows-live-stream.mjs",
    "test:windows-environments": "node scripts/test-windows-environments.mjs",
    "test:windows-live-environments": "node scripts/test-windows-live-environments.mjs",
    "test:windows-redraw": "node scripts/test-windows-redraw.mjs",
    "test:windows-package": "node scripts/test-windows-package.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "node scripts/test-browser.mjs",
    "test:tabby": "node scripts/test-tabby.mjs",
    "test:package": "node scripts/test-package.mjs",
    "setup:tabby": "node scripts/setup-tabby.mjs",
    "start": "node scripts/start-windows.mjs",
    "start:tabby": "node scripts/start-tabby.mjs",
    "dev:tabby": "node scripts/dev-tabby.mjs",
    "pack:plugin": "npm run build && node scripts/package-plugin.mjs",
    "install:tabby": "node scripts/manage-plugin.mjs install",
    "uninstall:tabby": "node scripts/manage-plugin.mjs uninstall",
    "verify": "npm run typecheck && npm test && npm run build && npm run test:browser && npm run test:package",
    "test:windows-core": "node scripts/test-windows-proof.mjs && node scripts/test-windows-worker.mjs",
    "test:windows-positions": "node scripts/test-windows-positions.mjs",
    "test:windows-bottom": "node scripts/test-windows-bottom.mjs",
    "test:windows-stream": "node scripts/test-windows-stream.mjs"
  },
  "devDependencies": {
    "@mathjax/mathjax-newcm-font": "4.1.3",
    "@mathjax/src": "4.1.3",
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "24.10.0",
    "@xterm/headless": "5.5.0",
    "@xterm/xterm": "5.5.0",
    "esbuild": "0.25.12",
    "get-east-asian-width": "1.5.0",
    "mdast-util-from-markdown": "2.0.2",
    "playwright-core": "1.64.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
